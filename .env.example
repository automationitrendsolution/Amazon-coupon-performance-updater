# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Amazon SP-API (Login with Amazon app credentials) ----------------------------
# From Seller Central > Apps & Services > Develop Apps > your app > "View" LWA credentials.
SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPAPI_LWA_CLIENT_SECRET=replace-me
SPAPI_LWA_REFRESH_TOKEN=Atzr|replace-me
SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER

# Refresh token from authorising the app for the selling account (self-authorisation).
# The app needs a role that covers coupon reports (Pricing / Selling Partner Insights).
# Amazon.com (US)

# Optional: overrides the regional endpoint derived from the marketplace.
# SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com

# AWS IAM keys / role ARN / SigV4 signing are NOT needed: SP-API has accepted LWA-only
# requests since October 2023.

# --- MySQL ---------------------------------------------------------------------------
# The table the coupon rows are written to; `run.py --inspect` reads it only.
# POWERBI_DB_HOST/_PORT/_USER/_PASSWORD/_NAME work too.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=powerbidb
COUPON_TABLE=api_coupon_data

# --- Behaviour -----------------------------------------------------------------------
# Coupons whose campaign STARTS in [today - LOOKBACK, today + LOOKAHEAD] (UTC) are requested.
COUPON_LOOKBACK_DAYS=30
COUPON_LOOKAHEAD_DAYS=10
# How often and how long one run waits for Amazon: 1 min, 2 h.
COUPON_POLL_INTERVAL_SECONDS=60
COUPON_POLL_TIMEOUT_SECONDS=7200
COUPON_MAX_RETRIES=6
LOG_LEVEL=INFO
# Optional: move data/ (raw reports, state) or logs/ elsewhere.
# COUPON_DATA_DIR=/data/cron/amazon-coupon-performance-updater/data
# COUPON_LOG_DIR=/data/cron/amazon-coupon-performance-updater/logs
